# PostgreSQL direct connection string for ledger transactions (distinct from SUPABASE_URL)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
COUPLE_SETUP_CODE=
LINE_LOGIN_CHANNEL_ID=
NEXT_PUBLIC_LIFF_ID=
NEXT_PUBLIC_LINE_BASIC_ID=
LIFF_SESSION_SECRET=
APP_URL=
CRON_SECRET=

# --- Couple Ledger V2 (disabled unless explicitly enabled) ---
# Server/API mutation plane. Keep 0 until the shadow migration and cutover
# gates have been reviewed for the target couple.
V2_LEDGER_ENABLED=0
# Browser V2 Ledger UI. Requires the server flag above and a migrated couple.
NEXT_PUBLIC_V2_LEDGER_UI=0
# Durable LINE inbox consumer. Keep 0 until the inbox migration is applied.
V2_LINE_INBOX_ENABLED=0

# --- Live smoke credentials (required only for pnpm smoke:* commands) ---
# Owner LINE user ID — must already exist in the `users` table.
SMOKE_LINE_USER_ID=
# Partner LINE user ID — must already exist in the `users` table.
SMOKE_PARTNER_LINE_USER_ID=
# Target couple group name; created on first smoke run if missing.
SMOKE_GROUP_NAME=
# 'always' (default) cleans up after every run; 'on-success' only on success.
SMOKE_CLEANUP_MODE=always
